DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-local-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://nau_coffee_app:YOUR_LOCAL_SECRET@127.0.0.1:5432/nau_coffee_dev
# SQLite only for explicitly isolated fallback tests, never normal development.
NAU_TEST_SQLITE=False
# Enable only after safe migration/QA on isolated environment. No Google API needed.
NAU_DEMO_DELIVERY_ENABLED=False

# Gmail SMTP: App Password only, never the Google sign-in password.
# An optional owned0600 secrets file can be selected with NAU_SMTP_ENV_FILE.
# Existing environment values take precedence; no automatic fallback backend.
# NAU_SMTP_ENV_FILE=/absolute/path/to/.env.smtp.gmail
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_TIMEOUT=15
DJANGO_EMAIL_HOST_USER=naucoffee.official@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
DJANGO_DEFAULT_FROM_EMAIL="Nâu Coffee <naucoffee.official@gmail.com>"
NAU_ACCOUNT_EMAIL_READY=False
# Set a verified public HTTPS origin before any approved live send.
NAU_ACCOUNT_PUBLIC_ORIGIN=
NAU_CUSTOMER_ACCOUNTS_ENABLED=False
NAU_VOUCHERS_V2_ENABLED=False

# Standard Django password reset token lifetime, seconds (60..86400).
NAU_PASSWORD_RESET_TIMEOUT=3600
